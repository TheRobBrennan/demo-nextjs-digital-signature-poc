# Copy to .env (or run `make setup`). Source of truth for what is configurable.
# These are demo credentials for containers bound to localhost. Do not reuse
# them anywhere that matters.

COMPOSE_PROJECT_NAME=sigdemo

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=sigdemo
POSTGRES_PASSWORD=sigdemo
POSTGRES_DB=sigdemo
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sigdemo:sigdemo@localhost:5432/sigdemo

# --- Object storage (MinIO, S3-compatible) ----------------------------------
# See docs/adr/0001-minio-for-document-storage.md
MINIO_ROOT_USER=sigdemo
MINIO_ROOT_PASSWORD=sigdemo123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=documents
S3_ACCESS_KEY_ID=sigdemo
S3_SECRET_ACCESS_KEY=sigdemo123
S3_FORCE_PATH_STYLE=true

# --- Signing ----------------------------------------------------------------
# Generated on first use if absent. Gitignored - never commit a key.
SIGNING_KEY_PATH=./keys/signing-key.pem
